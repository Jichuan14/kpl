# This path is inside the API container. Compose persists it to
# ./backend/data on the ECS disk.
DATABASE_URL=sqlite:////app/backend/data/kpl_bp.db

COMP_BASE_URL=https://prod.comp.smoba.qq.com
TGA_BASE_URL=https://tga-openapi.tga.qq.com
SYNC_REQUEST_DELAY=0.2

# Add exact origins only when a different domain calls the API directly.
CORS_ORIGINS=https://kpl.example.com

# Generate with: openssl rand -hex 32
# Keep the real value only in .env.production and the macOS Keychain. This
# enables the read-only SwiftBar visitor widget; leave blank to disable it.
ANALYTICS_WIDGET_TOKEN=

# Public simulator abuse protection. Use true only after the Caddy/Nginx
# proxy chain is configured to replace, rather than accept, client IP headers.
SIMULATION_IP_REQUESTS_PER_MINUTE=30
SIMULATION_IP_REQUESTS_PER_DAY=500
SIMULATION_SERVER_REQUESTS_PER_MINUTE=60
SIMULATION_SERVER_REQUESTS_PER_DAY=5000
SIMULATION_IP_MAX_ACTIVE_REQUESTS=1
SIMULATION_SERVER_MAX_ACTIVE_REQUESTS=2
SIMULATION_TRUST_PROXY_HEADERS=false
