#!/bin/sh

set -eu

API="${KPL_API_URL:-https://kpllab.xyz}"
AUTH_FILE="${KPL_AUTH_FILE:-/etc/kpl-sync.netrc}"
LEAGUE_ID="${KPL_LEAGUE_ID:-}"
POLL_SECONDS="${KPL_POLL_SECONDS:-30}"
MAX_POLLS="${KPL_MAX_POLLS:-420}"
CURL_BIN="${KPL_CURL_BIN:-/usr/bin/curl}"

log() {
  printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$*"
}

request() {
  method="$1"
  endpoint="$2"
  body="${3:-}"
  if [ -n "$body" ]; then
    "$CURL_BIN" --fail-with-body --silent --show-error \
      --connect-timeout 10 --max-time 30 --netrc-file "$AUTH_FILE" \
      -H 'Content-Type: application/json' -X "$method" \
      "$API$endpoint" -d "$body"
  else
    "$CURL_BIN" --fail-with-body --silent --show-error \
      --connect-timeout 10 --max-time 30 --netrc-file "$AUTH_FILE" \
      -X "$method" "$API$endpoint"
  fi
}

if [ -n "$LEAGUE_ID" ]; then
  case "$LEAGUE_ID" in
    *[!A-Za-z0-9_-]*) log "Invalid KPL_LEAGUE_ID override" >&2; exit 2 ;;
  esac
  log "Submitting 03:00 China-time KPL refresh for pinned league $LEAGUE_ID"
  body="{\"league_id\":\"$LEAGUE_ID\"}"
else
  log "Submitting 03:00 China-time KPL refresh for the current started league"
  body='{}'
fi
response=$(request POST /api/jobs/scheduled "$body")
printf '%s\n' "$response"
printf '%s' "$response" | /usr/bin/jq -e \
  '.success == true and (.data.id | type == "string") and (.data.status_url | type == "string")' >/dev/null
status_url=$(printf '%s' "$response" | /usr/bin/jq -r '.data.status_url')
log "Tracking refresh job at $status_url"

poll=0
last_state=""
while [ "$poll" -lt "$MAX_POLLS" ]; do
  if status_response=$(request GET "$status_url"); then
    if printf '%s' "$status_response" | /usr/bin/jq -e '.success == true and (.data.status | type == "string")' >/dev/null; then
      state=$(printf '%s' "$status_response" | /usr/bin/jq -r '.data.status + ":" + .data.stage')
      if [ "$state" != "$last_state" ]; then
        log "Refresh job $state"
        last_state="$state"
      fi
      status=$(printf '%s' "$status_response" | /usr/bin/jq -r '.data.status')
      case "$status" in
        completed)
          resolved_league=$(printf '%s' "$status_response" | /usr/bin/jq -r '.data.league_id // "unknown"')
          log "Scheduled KPL refresh completed for league $resolved_league"
          exit 0
          ;;
        failed)
          error=$(printf '%s' "$status_response" | /usr/bin/jq -r '.data.error // "unknown error"')
          log "Scheduled KPL refresh failed: $error" >&2
          exit 1
          ;;
      esac
    else
      log "Invalid job status response" >&2
    fi
  else
    log "Could not fetch job status; retrying" >&2
  fi
  poll=$((poll + 1))
  sleep "$POLL_SECONDS"
done
log "Timed out waiting for job $status_url; inspect /management" >&2
exit 1
