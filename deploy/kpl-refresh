#!/bin/sh

set -eu

API="${KPL_API_URL:-https://kpllab.xyz}"
AUTH_FILE="${KPL_AUTH_FILE:-/etc/kpl-sync.netrc}"
LEAGUE_ID="${KPL_LEAGUE_ID:-20260003}"

log() {
  printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$*"
}

request() {
  method="$1"
  endpoint="$2"
  timeout="$3"
  body="${4:-}"

  if [ -n "$body" ]; then
    if ! response=$(
      /usr/bin/curl --fail-with-body --silent --show-error \
        --connect-timeout 30 --max-time "$timeout" \
        --netrc-file "$AUTH_FILE" \
        -H 'Content-Type: application/json' \
        -X "$method" "$API$endpoint" \
        -d "$body"
    ); then
      log "$method $endpoint failed" >&2
      [ -z "$response" ] || printf '%s\n' "$response" >&2
      return 1
    fi
  else
    if ! response=$(
      /usr/bin/curl --fail-with-body --silent --show-error \
        --connect-timeout 30 --max-time "$timeout" \
        --netrc-file "$AUTH_FILE" \
        -X "$method" "$API$endpoint"
    ); then
      log "$method $endpoint failed" >&2
      [ -z "$response" ] || printf '%s\n' "$response" >&2
      return 1
    fi
  fi

  printf '%s\n' "$response"
}

log "Starting scheduled KPL refresh for league $LEAGUE_ID"

sync_result=$(request POST /api/sync/league-bp 1000 \
  "{\"league_id\":\"$LEAGUE_ID\",\"incremental\":true,\"run_analysis\":false}")
printf '%s\n' "$sync_result"

printf '%s' "$sync_result" | /usr/bin/jq -e \
  '.success == true and (.data.data_changed | type == "boolean")' >/dev/null
data_changed=$(printf '%s' "$sync_result" | /usr/bin/jq -r '.data.data_changed')

status_result=$(request GET "/api/data/status?league_id=$LEAGUE_ID" 120)
printf '%s' "$status_result" | /usr/bin/jq -e '.success == true' >/dev/null
analysis_ready=$(printf '%s' "$status_result" | /usr/bin/jq -r \
  'if .data.analysis_ready == true then "true" else "false" end')
frontend_ready=$(printf '%s' "$status_result" | /usr/bin/jq -r \
  'if ((.data.frontend_assets // []) | length) > 0 and ((.data.frontend_assets // []) | all(.ready == true)) then "true" else "false" end')

if [ "$data_changed" = "true" ] || [ "$analysis_ready" != "true" ]; then
  log "Running analysis (data_changed=$data_changed, analysis_ready=$analysis_ready)"
  analysis_result=$(request POST /api/pipeline/run 3700 \
    "{\"league_id\":\"$LEAGUE_ID\",\"step\":\"all\"}")
  printf '%s\n' "$analysis_result"
  printf '%s' "$analysis_result" | /usr/bin/jq -e '.success == true' >/dev/null
  frontend_ready="false"
else
  log "Analysis is already current"
fi

if [ "$frontend_ready" != "true" ]; then
  log "Publishing frontend assets"
  publish_result=$(request POST /api/pipeline/publish 300 \
    "{\"league_id\":\"$LEAGUE_ID\"}")
  printf '%s\n' "$publish_result"
  printf '%s' "$publish_result" | /usr/bin/jq -e '.success == true' >/dev/null
else
  log "Frontend assets are already current"
fi

log "Scheduled KPL refresh completed"
