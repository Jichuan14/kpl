# SQLite by default (zero setup). For hosting, switch to Postgres:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/kpl_bp
DATABASE_URL=sqlite:///./data/kpl_bp.db

COMP_BASE_URL=https://prod.comp.smoba.qq.com
TGA_BASE_URL=https://tga-openapi.tga.qq.com

# Seconds between KPL API calls during sync (be polite)
SYNC_REQUEST_DELAY=0.2

# Kimi is called only from FastAPI. Put the real key in backend/.env, never
# here and never in frontend code.
MOONSHOT_API_KEY=
# International key from platform.kimi.ai:
KIMI_BASE_URL=https://api.moonshot.ai/v1
# Mainland-China key from platform.kimi.com instead uses:
# KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6
KIMI_TIMEOUT_SECONDS=45
KIMI_MAX_TOOL_ROUNDS=3
KIMI_MAX_TOOL_CALLS=8
KIMI_MAX_OUTPUT_TOKENS=600
# Scout reports contain two team profiles and therefore need a larger response
# budget than a normal chat reply.
SCOUT_REPORT_MAX_OUTPUT_TOKENS=1200

# Draft Coach abuse protection. These values are per FastAPI process and reset
# when it restarts. Set COACH_TRUST_PROXY_HEADERS=true only when the API is
# reachable exclusively through a trusted reverse proxy such as Cloudflare.
COACH_IP_REQUESTS_PER_MINUTE=5
COACH_IP_REQUESTS_PER_DAY=50
COACH_SERVER_REQUESTS_PER_MINUTE=30
COACH_SERVER_REQUESTS_PER_DAY=500
COACH_IP_MAX_ACTIVE_REQUESTS=1
COACH_SERVER_MAX_ACTIVE_REQUESTS=4
COACH_TRUST_PROXY_HEADERS=false

# Public simulator abuse protection. The simulator always uses 100 fixed
# rollouts; these limits prevent request floods. Set the proxy option only
# when the API is reachable exclusively through trusted reverse proxies.
SIMULATION_IP_REQUESTS_PER_MINUTE=120
SIMULATION_IP_REQUESTS_PER_DAY=10000
SIMULATION_SERVER_REQUESTS_PER_MINUTE=2000
SIMULATION_SERVER_REQUESTS_PER_DAY=200000
SIMULATION_IP_MAX_ACTIVE_REQUESTS=5
SIMULATION_SERVER_MAX_ACTIVE_REQUESTS=100
SIMULATION_TRUST_PROXY_HEADERS=false

# Optional read-only credential for macOS/SwiftBar visitor monitoring. Generate
# a value with `openssl rand -hex 32`; never put it in frontend code.
ANALYTICS_WIDGET_TOKEN=
